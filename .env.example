# Provider selection (anthropic or openai)
AGENT_PROVIDER=anthropic

# Required for Anthropic provider
ANTHROPIC_API_KEY=sk-ant-...

# Required for OpenAI provider
# OPENAI_API_KEY=sk-proj-...

# Reasoning effort per provider (higher = better planning, more tokens/slower)
# Anthropic (claude-sonnet-5): low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# OpenAI (gpt-5.5): low | medium | high | xhigh
OPENAI_EFFORT=medium

# GCP (for docs-agent-gcp)
GCP_PROJECT=your-gcp-project-id
GCS_BUCKET=your-bucket-name

# Optional (defaults shown)
GCP_ZONE=us-central1-a
GCP_MACHINE_TYPE=e2-standard-4
GCP_DISK_SIZE=50
GCP_SPOT=true

# AWS (for docs-agent-aws)
AWS_REGION=us-east-1
S3_BUCKET=your-s3-bucket
# AWS_INSTANCE_TYPE=m5.xlarge
# AWS_DISK_SIZE=50
# AWS_SPOT=true
# AWS_IAM_INSTANCE_PROFILE=your-instance-profile-name
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_KEY_PAIR=your-key-pair
# AWS_SECURITY_GROUP=sg-...
# AWS_SUBNET_ID=subnet-...

# Agent options (passed to docs-agent CLI)
# Leave empty for full run, or set to e.g.: --project examples/whodb --session "Data Management"
DOCS_AGENT_ARGS=
